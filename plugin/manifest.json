{
  "manifestVersion": 5,
  "id": "cn.local.html-to-photoshop-auto",
  "name": "HTML 自动分组导入",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "26.0.0", "data": { "apiVersion": 2, "loadEvent": "use" } },
  "entrypoints": [
    {
      "type": "panel",
      "id": "htmlImportPanel",
      "label": { "default": "HTML 自动分组导入" },
      "minimumSize": { "width": 340, "height": 540 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 400, "height": 650 },
      "preferredFloatingSize": { "width": 420, "height": 730 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": "all" }
  }
}
